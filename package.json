{
  "name": "gigamail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first, self-hosted multi-account mail client.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"node --watch server/index.js\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "npm run build && node --check server/index.js",
    "test": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.0.190",
    "mailparser": "^3.9.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.17.0",
    "undici": "^7.16.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
