# Docker Compose project name. This scopes containers, networks, and volumes
# so this deployment does not touch other Compose projects on the host.
# Use a distinct project name so Compose never targets another stack. Change
# this if the same VM hosts a different GigaMail installation.
COMPOSE_PROJECT_NAME=gigamail-xer0

# The browser-facing service binds only to the VM loopback interface by
# default. Access it through an SSH tunnel (see deploy/README.md). If an
# HTTPS reverse proxy on your LAN must reach the VM directly, bind only to the
# VM's private address (for example 10.0.0.15), never 0.0.0.0.
GIGAMAIL_BIND_ADDRESS=127.0.0.1
GIGAMAIL_PORT=3080

# Required: a high-entropy secret (for example: `openssl rand -hex 32`). It
# encrypts saved IMAP/SMTP credentials at rest. Never rotate it without first
# decrypting/re-encrypting the stored account credentials.
GIGAMAIL_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Required: a separate high-entropy token used to authenticate browser/API
# access. Generate with: openssl rand -hex 32
GIGAMAIL_ACCESS_TOKEN=replace-with-a-long-random-access-token

# Optional. If omitted, GIGAMAIL_ENCRYPTION_KEY is used for short-lived remote
# content tokens. Use a separate value if you prefer key separation.
GIGAMAIL_REMOTE_TOKEN_KEY=

# Default: leave empty. The privacy launch command temporarily sets this to
# http://tor-proxy:8118. In production, remote-content loading fails closed
# when this proxy is absent; it never silently falls back to a direct fetch.
REMOTE_CONTENT_PROXY_URL=

# Conservative server defaults.
GIGAMAIL_TRUST_PROXY=false
GIGAMAIL_ALLOW_INSECURE_TLS=false
# The newest messages imported per folder during the initial sync (1–1000).
# Older history is not automatically backfilled; raise this before connecting
# an account if a larger recent window is needed.
GIGAMAIL_SYNC_BATCH_SIZE=200
GIGAMAIL_SYNC_TIMEOUT_MS=60000
# Maximum raw RFC822 bytes downloaded and parsed for one message (64 KiB–50
# MiB). Choose this before the first account sync: larger messages are skipped,
# and raising the cap later affects future messages rather than backfilling them.
GIGAMAIL_SYNC_MAX_MESSAGE_BYTES=10485760
# Poll enabled inboxes sequentially every five minutes. Set 0 to disable
# background syncing and use the Refresh control/API manually instead.
SYNC_INTERVAL_MINUTES=5
GIGAMAIL_REMOTE_CONTENT_MAX_BYTES=5242880
GIGAMAIL_REMOTE_CONTENT_TIMEOUT_MS=12000
# Signed image capability URLs are short-lived and are never written to logs.
GIGAMAIL_REMOTE_CONTENT_TOKEN_TTL=300
LOG_LEVEL=info

# Passkeys (WebAuthn). These must match the browser origin on
# https://mail.xer0.io. Production also applies this pin when the values
# are left empty. Override only if the public hostname changes.
GIGAMAIL_RP_ID=mail.xer0.io
GIGAMAIL_ORIGIN=https://mail.xer0.io
